---
import Layout from '../../layouts/Layout.astro';
import type { CpuIndex, GpuIndex } from '../../types/components';
import cpuData from '../../data/index/cpus.index.json';
import gpuData from '../../data/index/gpus.index.json';

const gpus = gpuData.items as GpuIndex[];
const cpus = cpuData.items as CpuIndex[];

const pageTitle = "Real-World PC Power Consumption Database: Measured Specs — PSUCheck";
const pageDescription = "Explore our measured power consumption database for modern CPUs and GPUs. Compare manufacturer TDP specs against oscilloscope-measured idle, gaming, stress peak, and transient spike draws.";

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "PC Power Consumption Database",
  "url": "https://psucheck.com/power-consumption/",
  "description": pageDescription,
  "publisher": {
    "@type": "Organization",
    "name": "PSUCheck",
    "url": "https://psucheck.com"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why does actual hardware power draw differ from manufacturer TDP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Manufacturer TDP (Thermal Design Power) measures heat dissipation targets under nominal base clocks. In real-world workloads, modern boosting algorithms (Intel PL2/Velocity Boost, AMD PBO, NVIDIA GPU Boost) draw significantly more electrical power under dynamic gaming and rendering loads."
      }
    },
    {
      "@type": "Question",
      "name": "Where does PSUCheck source its measured power draw data?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Data is sourced from hardware oscilloscope testing suites and power logging databases published by TechPowerUp, Tom's Hardware, and Cybenetics Lab, reflecting actual current drawn at the PCIe and EPS12V rails."
      }
    }
  ]
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schema={[schema, faqSchema]}
>
  <section class="power-hub-page" aria-labelledby="hub-heading">
    <div class="container">
      <nav class="calc-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">Power Consumption</span>
      </nav>

      <header class="hub-header">
        <div class="section-eyebrow">Lab Benchmarks & Oscilloscope Testing</div>
        <h1 id="hub-heading">
          Real-World PC <span class="gradient-text">Power Draw Database</span>
        </h1>
        <p class="hub-intro">
          Compare manufacturer TDP/TBP specifications with actual measured idle, typical gaming, peak synthetic stress, and sub-millisecond transient power spikes measured across modern graphics cards and processors.
        </p>
      </header>

      {/* === GPU POWER SECTION === */}
      <section style="margin-bottom: 3.5rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom: 2px solid var(--color-border-subtle); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
          <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary); margin:0;">
            🎮 Graphics Card (GPU) Measured Power Draw
          </h2>
          <span style="font-size:0.75rem; color:var(--text-tertiary); font-weight:700; text-transform:uppercase;">{gpus.length} Models Tested</span>
        </div>

        <div class="power-grid">
          {gpus.map(gpu => {
            const specWatts = gpu.tbp;
            const peakWatts = gpu.measuredPeakWatts || specWatts;
            const gamingWatts = gpu.measuredGamingWatts || Math.round(specWatts * 0.82);
            const transientWatts = gpu.measuredTransientWatts || Math.round(specWatts * gpu.transientMultiplier);

            return (
              <div class="power-card card" key={gpu.id}>
                <div>
                  <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                    <div>
                      <span class="power-brand">{gpu.brand}</span>
                      <h3 class="power-title">{gpu.name}</h3>
                    </div>
                    <span class="power-tag">{specWatts}W Spec</span>
                  </div>

                  <div class="power-bars-mini" style="margin-top: 1rem; display:flex; flex-direction:column; gap:0.5rem;">
                    <div style="display:flex; justify-content:space-between; font-size:0.75rem;">
                      <span style="color:var(--text-secondary);">Gaming Draw:</span>
                      <strong style="color:var(--color-accent-amber); font-family:var(--font-mono);">{gamingWatts}W</strong>
                    </div>
                    <div style="display:flex; justify-content:space-between; font-size:0.75rem;">
                      <span style="color:var(--text-secondary);">Stress Peak:</span>
                      <strong style="color:var(--color-accent-cyan); font-family:var(--font-mono);">{peakWatts}W</strong>
                    </div>
                    <div style="display:flex; justify-content:space-between; font-size:0.75rem;">
                      <span style="color:var(--text-secondary);">Transient Spike:</span>
                      <strong style="color:var(--status-danger); font-family:var(--font-mono);">{transientWatts}W</strong>
                    </div>
                  </div>
                </div>

                <a href={`/power-consumption/${gpu.id}/`} class="btn btn-secondary btn-sm" style="margin-top:1.25rem; text-align:center; justify-content:center;">
                  Detailed Analysis & Sizing →
                </a>
              </div>
            );
          })}
        </div>
      </section>

      {/* === CPU POWER SECTION === */}
      <section style="margin-bottom: 3.5rem;">
        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom: 2px solid var(--color-border-subtle); padding-bottom: 0.5rem; margin-bottom: 1.5rem;">
          <h2 style="font-size: 1.5rem; font-weight: 800; color: var(--text-primary); margin:0;">
            🖥️ Processor (CPU) Measured Power Draw
          </h2>
          <span style="font-size:0.75rem; color:var(--text-tertiary); font-weight:700; text-transform:uppercase;">{cpus.length} Models Tested</span>
        </div>

        <div class="power-grid">
          {cpus.map(cpu => {
            const specWatts = cpu.tdp;
            const sustainedWatts = cpu.tdpSustained || specWatts;
            const peakWatts = cpu.measuredPeakWatts || sustainedWatts;
            const gamingWatts = cpu.measuredGamingWatts || Math.round(sustainedWatts * 0.65);

            return (
              <div class="power-card card" key={cpu.id}>
                <div>
                  <div style="display:flex; justify-content:space-between; align-items:flex-start;">
                    <div>
                      <span class="power-brand">{cpu.brand}</span>
                      <h3 class="power-title">{cpu.name}</h3>
                    </div>
                    <span class="power-tag">{specWatts}W TDP</span>
                  </div>

                  <div class="power-bars-mini" style="margin-top: 1rem; display:flex; flex-direction:column; gap:0.5rem;">
                    <div style="display:flex; justify-content:space-between; font-size:0.75rem;">
                      <span style="color:var(--text-secondary);">Gaming Load:</span>
                      <strong style="color:var(--color-accent-amber); font-family:var(--font-mono);">{gamingWatts}W</strong>
                    </div>
                    <div style="display:flex; justify-content:space-between; font-size:0.75rem;">
                      <span style="color:var(--text-secondary);">PL2 / Boost Peak:</span>
                      <strong style="color:var(--color-accent-cyan); font-family:var(--font-mono);">{peakWatts}W</strong>
                    </div>
                    <div style="display:flex; justify-content:space-between; font-size:0.75rem;">
                      <span style="color:var(--text-secondary);">Socket:</span>
                      <span style="color:var(--text-primary); font-family:var(--font-mono); font-size:0.75rem;">{cpu.socket}</span>
                    </div>
                  </div>
                </div>

                <a href={`/power-consumption/${cpu.id}/`} class="btn btn-secondary btn-sm" style="margin-top:1.25rem; text-align:center; justify-content:center;">
                  Detailed Analysis & Sizing →
                </a>
              </div>
            );
          })}
        </div>
      </section>

      {/* === METHODOLOGY FOOTER NOTE === */}
      <section class="card" style="padding: 2rem; border-left: 4px solid var(--color-accent-cyan);">
        <h2 style="font-size: 1.15rem; font-weight: 800; color: var(--text-primary); margin:0 0 0.5rem;">
          🔬 Lab Measurement Protocol & Equipment
        </h2>
        <p style="color: var(--text-secondary); font-size: 0.875rem; line-height: 1.6; margin: 0;">
          All measured readings reflect physical power sensor logging (Powenetics & oscilloscope shunts) at the EPS 12V and PCIe slots, eliminating software-reported driver throttling bias. Sourced with attribution from TechPowerUp, Tom's Hardware, and Cybenetics power testing suites.
        </p>
      </section>
    </div>
  </section>
</Layout>

<style>
.power-hub-page {
  padding: 3rem 0 6rem;
}
.hub-header {
  margin-top: 1.5rem;
  margin-bottom: 2.5rem;
}
.hub-header h1 {
  font-size: clamp(1.75rem, 4.5vw, 2.75rem);
  font-weight: 850;
  line-height: 1.15;
  letter-spacing: -0.03em;
}
.hub-intro {
  font-size: 1rem;
  color: var(--text-secondary);
  margin-top: 0.75rem;
  max-width: 75ch;
}
.power-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.25rem;
}
.power-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border-subtle);
  border-radius: var(--radius-lg);
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: border-color 0.15s, transform 0.1s;
}
.power-card:hover {
  border-color: var(--border-accent);
  transform: translateY(-2px);
}
.power-brand {
  font-size: 0.6875rem;
  font-weight: 700;
  color: var(--text-tertiary);
  text-transform: uppercase;
  letter-spacing: 0.06em;
}
.power-title {
  font-size: 1.0625rem;
  font-weight: 700;
  color: var(--text-primary);
  margin: 0.15rem 0 0;
}
.power-tag {
  font-size: 0.6875rem;
  font-weight: 700;
  padding: 2px 6px;
  background: var(--bg-secondary);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  color: var(--color-accent-cyan);
  font-family: var(--font-mono);
}
.btn-sm {
  font-size: 0.75rem !important;
  padding: 6px 12px !important;
  min-height: 32px !important;
}
</style>
