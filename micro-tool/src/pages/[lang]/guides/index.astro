---
import Layout from '../../../layouts/Layout.astro';
import { TARGET_LOCALES, useTranslations, l, type Locale } from '../../../i18n';
import { getLocalizedGuides } from '../../../i18n/guides';

export async function getStaticPaths() {
  return TARGET_LOCALES.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const localizedGuides = getLocalizedGuides(lang);

const websiteSchema = {
  "@type": "CollectionPage",
  "name": `${localizedGuides.pageTitle}`,
  "url": `https://psucheck.com/${lang}/guides`,
  "description": localizedGuides.pageSubtitle
};
---

<Layout
  title={localizedGuides.pageTitle}
  description={localizedGuides.pageSubtitle}
  schema={websiteSchema}
  lang={lang}
>
  <section class="guides-hero" aria-labelledby="guides-hero-heading">
    <div class="container">
      <div class="guides-hero-inner">
        <h1 id="guides-hero-heading" class="calc-h1">
          {localizedGuides.heroTitle} <span class="gradient-text">{localizedGuides.heroHighlight}</span>
        </h1>
        <p class="calc-subtitle">
          {localizedGuides.pageSubtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Access PSU Finder Tools -->
  <section style="padding: 1.5rem 0 0;">
    <div class="container">
      <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
        <a href={l('/psu-for/rtx-5080', lang)} class="card" style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem; text-decoration:none; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); transition: border-color 0.15s;">
          <div>
            <div style="font-size:0.6875rem; font-weight:700; color:var(--color-accent-cyan); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.25rem;">{localizedGuides.matchmakerBadge}</div>
            <span style="font-size:1rem; font-weight:700; color:var(--text-primary);">{localizedGuides.matchmakerTitle}</span>
            <p style="font-size:0.75rem; color:var(--text-secondary); margin:0.25rem 0 0;">{localizedGuides.matchmakerDesc}</p>
          </div>
        </a>
        <a href={l('/psu-for/best-under-150', lang)} class="card" style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem; text-decoration:none; border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); transition: border-color 0.15s;">
          <div>
            <div style="font-size:0.6875rem; font-weight:700; color:var(--color-accent-cyan); text-transform:uppercase; letter-spacing:0.06em; margin-bottom:0.25rem;">{localizedGuides.budgetFinderBadge}</div>
            <span style="font-size:1rem; font-weight:700; color:var(--text-primary);">{localizedGuides.budgetFinderTitle}</span>
            <p style="font-size:0.75rem; color:var(--text-secondary); margin:0.25rem 0 0;">{localizedGuides.budgetFinderDesc}</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="guides-directory">
    <div class="container">
      <div class="guides-grid">
        {localizedGuides.categories.map(category => (
          <div class="guides-category-box card">
            <h2 class="category-title">{category.title}</h2>
            <p class="category-desc">{category.description}</p>
            <hr class="category-divider" />
            <ul class="guide-links-list">
              {category.links.map(link => (
                <li class="guide-link-item">
                  <a href={l(link.href, lang)} class="guide-anchor">
                    <span class="guide-link-name">{link.name}</span>
                    <span class="guide-link-arrow">→</span>
                  </a>
                  <p class="guide-link-desc">{link.desc}</p>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
.guides-hero {
  padding: 5rem 0 3rem;
  background: var(--bg-primary);
  border-bottom: 1px solid var(--border-subtle);
}
.guides-hero-inner {
  max-width: 800px;
}
.guides-directory {
  padding: 4rem 0 6rem;
  background: var(--bg-primary);
}
.guides-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}
@media (min-width: 1024px) {
  .guides-grid {
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
  }
}
.guides-category-box {
  padding: 2rem;
  background: var(--bg-secondary);
  border: 1px solid var(--border-default);
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  height: 100%;
}
.category-title {
  font-size: 1.25rem;
  font-weight: 800;
  color: var(--text-primary);
  margin-bottom: 0.5rem;
}
.category-desc {
  font-size: 0.875rem;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 1.25rem;
}
.category-divider {
  border: 0;
  height: 1px;
  background: var(--border-subtle);
  margin: 0 0 1.5rem 0;
}
.guide-links-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.guide-link-item {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.guide-anchor {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--color-accent-cyan);
  text-decoration: none;
  transition: color 0.2s ease;
}
.guide-anchor:hover {
  color: var(--color-accent-blue);
}
.guide-anchor:hover .guide-link-arrow {
  transform: translateX(4px);
}
.guide-link-arrow {
  font-family: var(--font-mono);
  transition: transform 0.2s ease;
}
.guide-link-desc {
  font-size: 0.8125rem;
  color: var(--text-secondary);
  line-height: 1.4;
  margin: 0;
}
</style>
