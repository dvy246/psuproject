---
import Layout from '../../layouts/Layout.astro';
import { TARGET_LOCALES, useTranslations, l, type Locale } from '../../i18n';

export async function getStaticPaths() {
  return TARGET_LOCALES.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<Layout
  title={`${t.footer.privacy} — PSUCheck`}
  description={t.seo.defaultDescription}
>
  <div class="legal-page">
    <div class="legal-hero">
      <div class="container">
        <div class="badge badge-safe" style="margin-bottom:1rem;">Legal</div>
        <h1>{t.footer.privacy}</h1>
        <p class="legal-meta">Privacy &amp; Data Standards</p>
      </div>
    </div>

    <div class="legal-body">
      <div class="container">
        <div class="legal-content">
          <div class="legal-summary card-accent" style="padding:1.25rem; background:rgba(0,229,255,0.05); border:1px solid rgba(0,229,255,0.2); border-radius:var(--radius-md);">
            <strong>Plain-English Summary:</strong> PSUCheck runs calculator logic in your browser.
            We do not store your build configurations. We use privacy-preserving analytics. We do not sell your data. Ever.
          </div>

          <h2>1. Information We Collect</h2>
          <p>
            All calculator computations (component selections, PSU analysis, cost estimates) run
            entirely client-side in your web browser. <strong>PSUCheck does not transmit or store
            your component selections or build configurations.</strong>
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
.legal-hero {
  padding: 4rem 0 2rem;
  background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-primary) 100%);
  border-bottom: 1px solid var(--border-subtle);
}
.legal-meta {
  color: var(--text-tertiary);
  font-size: 0.875rem;
  margin-top: 0.5rem;
}
.legal-body {
  padding: 3rem 0 5rem;
}
.legal-content {
  max-width: 760px;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.legal-content h2 {
  font-size: 1.375rem;
  margin-top: 0.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border-subtle);
}
.legal-content p {
  color: var(--text-secondary);
  line-height: 1.75;
  max-width: 70ch;
}
</style>
