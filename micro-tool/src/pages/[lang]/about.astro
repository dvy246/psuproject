---
import Layout from '../../layouts/Layout.astro';
import { TARGET_LOCALES, useTranslations, l, type Locale } from '../../i18n';

export async function getStaticPaths() {
  return TARGET_LOCALES.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const schema = {
  "@type": "AboutPage",
  "name": `${t.nav.about} — PSUCheck`,
  "url": `https://psucheck.com/${lang}/about`,
  "description": t.seo.defaultDescription,
  "publisher": {
    "@type": "Organization",
    "name": "PSUCheck",
    "url": "https://psucheck.com"
  }
};
---

<Layout
  title={`${t.nav.about} — PSUCheck`}
  description={t.seo.defaultDescription}
  schema={schema}
>
  <div class="about-page">
    <section class="about-hero">
      <div class="container">
        <div class="about-badge">
          <span class="badge badge-safe">✓ Independent &amp; Unbiased</span>
        </div>
        <h1>{t.nav.about} PSUCheck</h1>
        <p class="about-lead">
          {t.hero.subtitle}
        </p>
      </div>
    </section>

    <section class="about-section">
      <div class="container">
        <div class="two-column" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); align-items:start; gap:3rem;">
          <div>
            <h2>What PSUCheck Is</h2>
            <p style="margin-top:0.75rem; color:var(--text-secondary); line-height:1.6;">
              PSUCheck is a free, independent web application that helps PC builders accurately calculate
              power supply requirements, estimate total build cost, and understand the real engineering
              behind modern PC power delivery.
            </p>
            <p style="margin-top:1rem; color:var(--text-secondary); line-height:1.6;">
              Unlike manufacturer tools that are structurally limited to recommending only their own products,
              PSUCheck is brand-agnostic. We recommend whatever PSU best fits your build — regardless of who makes it.
            </p>
          </div>
          <div>
            <h2>What PSUCheck Is Not</h2>
            <p style="margin-top:0.75rem; color:var(--text-secondary); line-height:1.6;">
              PSUCheck is not a retailer, manufacturer, or affiliated with any hardware company.
              We do not accept paid placements to boost specific power supplies in our recommendation engines.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
.about-hero {
  padding: 5rem 0 3rem;
  background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-primary) 100%);
  border-bottom: 1px solid var(--border-subtle);
}
.about-badge {
  margin-bottom: 1rem;
}
.about-lead {
  font-size: 1.25rem;
  line-height: 1.7;
  color: var(--text-secondary);
  max-width: 65ch;
  margin-top: 1rem;
}
.about-section {
  padding: 4rem 0;
}
</style>
