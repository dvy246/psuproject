---
import Layout from '../../../layouts/Layout.astro';
import buildsData from '../../../data/builds.json';
import cpuData from '../../../data/index/cpus.index.json';
import gpuData from '../../../data/index/gpus.index.json';
import psuData from '../../../data/index/psus.index.json';
import { calculateBaseDraw, calculateTransientPeak, calculateRecommendedWattage } from '../../../lib/psu';
import { TARGET_LOCALES, useTranslations, l, formatCurrency, type Locale } from '../../../i18n';
import { getLocalizedBuild } from '../../../i18n/builds';

export async function getStaticPaths() {
  const builds = buildsData.items;
  const paths = [];
  for (const lang of TARGET_LOCALES) {
    for (const b of builds) {
      paths.push({
        params: { lang, slug: b.slug },
        props: { build: b }
      });
    }
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const { build } = Astro.props;

const loc = getLocalizedBuild(build, lang);

const cpu = cpuData.items.find(c => c.id === build.cpuId) || null;
const gpu = gpuData.items.find(g => g.id === build.gpuId) || null;
const psu = psuData.items.find(p => p.id === build.psuId) || null;

const baseDraw = calculateBaseDraw({
  cpu: cpu as any,
  gpu: gpu as any,
  ram: build.ram as any,
  storage: (build.storage || []) as any,
  cooling: (build.cooling || null) as any,
  fans: build.fans || 3,
});

const transientPeak = calculateTransientPeak(cpu as any, gpu as any, baseDraw);
const recommendedWattage = calculateRecommendedWattage(
  transientPeak,
  psu?.atxVersion || '3.1',
  0.25,
  0
);

const isSafe = psu ? psu.wattage >= baseDraw : false;
const hasHeadroom = psu ? psu.wattage >= recommendedWattage : false;

const uiLabels: Record<Locale, {
