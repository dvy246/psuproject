    graphicsCard: '独立显卡 (GPU)',
    memory: '运行内存 (RAM)',
    storage: '高速固态 (SSD)',
    cooling: '散热系统',
    powerSupply: '电源适配 (PSU)',
    powerDiagnostics: '功耗与瞬态尖峰诊断',
