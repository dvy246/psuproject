const labels = uiLabels[lang] || uiLabels.en;

const schema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": `${loc.name} — PSUCheck`,
  "description": loc.description,
  "url": `https://psucheck.com/${lang}/builds/${build.slug}/`,
  "author": {
    "@type": "Organization",
    "name": "PSUCheck Editorial Team"
  }
};
---

<Layout
  title={`${loc.name} — PSUCheck`}
  description={loc.description}
  schema={schema}
>
  <div class="calc-header" style="background:linear-gradient(180deg, var(--color-surface-sunken) 0%, var(--color-surface-base) 100%); border-bottom:1px solid var(--color-border-subtle); padding: 3rem 0 2rem;">
    <div class="container" style="max-width:1100px; margin:0 auto; padding:0 1.5rem;">
      <nav class="calc-breadcrumb" aria-label="Breadcrumb" style="margin-bottom:1rem; font-size:0.8125rem; color:var(--color-text-tertiary);">
        <a href={l('/', lang)} style="color:var(--color-text-secondary); text-decoration:none;">{t.nav.home}</a>
        <span aria-hidden="true" style="margin:0 0.5rem;">›</span>
        <a href={l('/builds', lang)} style="color:var(--color-text-secondary); text-decoration:none;">{t.nav.completedBuilds}</a>
        <span aria-hidden="true" style="margin:0 0.5rem;">›</span>
        <span style="color:var(--color-text-primary);">{loc.name}</span>
      </nav>

      <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
        <div style="flex:1; min-width:280px;">
          <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:0.5rem;">
            <span class="badge badge-safe" style="text-transform:uppercase; font-size:0.75rem;">{loc.category}</span>
            <span style="font-size:0.8125rem; color:var(--color-text-tertiary);">{labels.createdBy} @{build.creator}</span>
          </div>
          <h1 style="font-size:2rem; font-weight:800; color:var(--color-text-primary); margin:0 0 0.75rem; line-height:1.2;">
            {loc.name}
          </h1>
          <p style="font-size:0.95rem; color:var(--color-text-secondary); max-width:750px; line-height:1.6; margin:0;">
            {loc.description}
          </p>
        </div>

        <div style="background:var(--color-surface-raised); border:1px solid var(--color-border-subtle); border-radius:var(--radius-lg); padding:1.25rem 1.5rem; text-align:right;">
          <div style="font-size:0.75rem; color:var(--color-text-tertiary); text-transform:uppercase;">{labels.totalBuildCost}</div>
          <div style="font-size:2rem; font-weight:850; font-family:var(--font-mono); color:var(--color-accent-cyan);">{formatCurrency(build.price || build.totalCost || 0, lang)}</div>
        </div>
      </div>
    </div>
  </div>

  <main class="container" style="max-width:1100px; margin:2.5rem auto 5rem; padding:0 1.5rem;">
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(320px, 1fr)); gap:2rem;">
      {/* Component Breakdown */}
      <div class="card card-dark" style="padding:1.5rem; border:1px solid var(--color-border-subtle); border-radius:var(--radius-lg);">
        <h2 style="font-size:1.25rem; font-weight:700; color:var(--color-text-primary); margin:0 0 1.25rem; border-bottom:1px solid var(--color-border-subtle); padding-bottom:0.75rem;">
          {labels.hardwareComponents}
        </h2>
        <div style="display:flex; flex-direction:column; gap:1rem;">
          <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.875rem;">
            <span style="color:var(--color-text-secondary);">{labels.processor}</span>
            <strong style="color:var(--color-text-primary);">{cpu?.name || build.cpuId}</strong>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.875rem;">
            <span style="color:var(--color-text-secondary);">{labels.graphicsCard}</span>
            <strong style="color:var(--color-text-primary);">{gpu?.name || build.gpuId}</strong>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.875rem;">
            <span style="color:var(--color-text-secondary);">{labels.memory}</span>
            <strong style="color:var(--color-text-primary);">{build.ram.capacity}GB {build.ram.type}-{build.ram.speed}</strong>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.875rem;">
            <span style="color:var(--color-text-secondary);">{labels.storage}</span>
            <strong style="color:var(--color-text-primary);">{build.storage?.[0]?.capacity || 1000}GB {build.storage?.[0]?.type || 'NVMe'}</strong>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.875rem;">
            <span style="color:var(--color-text-secondary);">{labels.cooling}</span>
            <strong style="color:var(--color-text-primary); text-transform:capitalize;">{build.cooling?.type || 'Air Cooler'}</strong>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.875rem; border-top:1px solid var(--color-border-subtle); padding-top:0.75rem;">
            <span style="color:var(--color-text-secondary);">{labels.powerSupply}</span>
            <strong style="color:var(--color-accent-cyan);">{psu?.name || build.psuId}</strong>
          </div>
        </div>
      </div>

      {/* Power Diagnostics */}
      <div class="card card-dark" style="padding:1.5rem; border:1px solid var(--color-border-subtle); border-radius:var(--radius-lg);">
        <h2 style="font-size:1.25rem; font-weight:700; color:var(--color-text-primary); margin:0 0 1.25rem; border-bottom:1px solid var(--color-border-subtle); padding-bottom:0.75rem;">
          {labels.powerDiagnostics}
        </h2>
        <div style="display:flex; flex-direction:column; gap:1.25rem;">
          <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
              <div style="font-size:0.8125rem; color:var(--color-text-secondary);">{labels.sustainedDraw}</div>
              <div style="font-size:1.5rem; font-weight:800; font-family:var(--font-mono); color:var(--color-text-primary);">{baseDraw}W</div>
            </div>
            <div style="text-align:right;">
              <div style="font-size:0.8125rem; color:var(--color-text-secondary);">{labels.transientPeak}</div>
              <div style="font-size:1.5rem; font-weight:800; font-family:var(--font-mono); color:var(--color-warning);">{transientPeak}W</div>
            </div>
          </div>

          <div style="padding:1rem; background:var(--color-surface-raised); border-radius:var(--radius-md); border:1px solid var(--color-border-subtle);">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.5rem;">
              <span style="font-size:0.8125rem; font-weight:600; color:var(--color-text-secondary);">{labels.compatibilityRating}</span>
              <span class={`badge ${hasHeadroom ? 'badge-safe' : isSafe ? 'badge-warning' : 'badge-danger'}`} style="font-size:0.75rem;">
                {hasHeadroom ? labels.optimal : isSafe ? labels.marginal : labels.overload}
              </span>
            </div>
            <p style="font-size:0.8125rem; color:var(--color-text-secondary); line-height:1.5; margin:0;">
              {hasHeadroom
                ? labels.optimalDesc(psu?.wattage || 750, transientPeak)
                : isSafe
                ? labels.marginalDesc(psu?.wattage || 750)
                : labels.overloadDesc}
            </p>
          </div>

          <div style="display:flex; gap:1rem; margin-top:0.5rem;">
            <a href={l(`/psu-calculator?cpu=${cpu?.id || ''}&gpu=${gpu?.id || ''}`, lang)} class="btn btn-primary" style="flex:1; text-align:center; text-decoration:none; padding:0.625rem; font-size:0.8125rem;">
              {labels.customizeCta}
            </a>
            <a href={l('/builds', lang)} class="btn btn-secondary" style="text-decoration:none; padding:0.625rem 1rem; font-size:0.8125rem;">
              {labels.backToGallery}
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
