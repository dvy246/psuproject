---
import Layout from '../../layouts/Layout.astro';
import { TARGET_LOCALES, useTranslations, l, type Locale } from '../../i18n';

export async function getStaticPaths() {
  return TARGET_LOCALES.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
---

<Layout
  title={`${t.footer.terms} — PSUCheck`}
  description={t.seo.defaultDescription}
>
  <div class="legal-page">
    <div class="legal-hero">
      <div class="container">
        <div class="badge badge-safe" style="margin-bottom:1rem;">Legal</div>
        <h1>{t.footer.terms}</h1>
      </div>
    </div>

    <div class="legal-body">
      <div class="container">
        <div class="legal-content">
          <h2>Terms of Use</h2>
          <p>
            By using PSUCheck, you agree to use our sizing and cost calculation tools for informational purposes.
            Always cross-reference official component specifications before purchasing hardware.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
.legal-hero {
  padding: 4rem 0 2rem;
  background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-primary) 100%);
  border-bottom: 1px solid var(--border-subtle);
}
.legal-body {
  padding: 3rem 0 5rem;
}
.legal-content {
  max-width: 760px;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.legal-content h2 {
  font-size: 1.375rem;
  margin-top: 0.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border-subtle);
}
.legal-content p {
  color: var(--text-secondary);
  line-height: 1.75;
  max-width: 70ch;
}
</style>
