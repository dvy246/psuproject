---
import Layout from '../../../layouts/Layout.astro';
import GpuUpgradeChecker from '../../../components/calculators/GpuUpgradeChecker';
import { TARGET_LOCALES, useTranslations, l, type Locale } from '../../../i18n';
import { GPU_UPGRADE_TRANSLATIONS } from '../../../i18n/gpuUpgrade';

import cpuData from '../../../data/index/cpus.index.json';
import gpuData from '../../../data/index/gpus.index.json';
import psuData from '../../../data/index/psus.index.json';

export async function getStaticPaths() {
  return TARGET_LOCALES.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const gpuTr = GPU_UPGRADE_TRANSLATIONS[lang] || GPU_UPGRADE_TRANSLATIONS.en;

const cpus = cpuData.items;
const gpus = gpuData.items;
const psus = psuData.items;

const pageTitle = `${gpuTr.title} — PSUCheck`;
const pageDescription = gpuTr.desc;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": `${gpuTr.title} — PSUCheck`,
  "url": `https://psucheck.com/${lang}/compare/gpu-upgrade-checker`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any",
  "description": pageDescription,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "inLanguage": lang
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  schema={[webAppSchema]}
  lang={lang}
>
  <section class="upgrade-checker-page" aria-labelledby="upgrade-heading">
    <div class="container">
      <nav class="calc-breadcrumb" aria-label="Breadcrumb">
        <a href={l('/', lang)}>{t.nav.home}</a>
        <span aria-hidden="true">›</span>
        <a href={l('/compare', lang)}>{t.footer.calculatorsCol}</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{gpuTr.title}</span>
      </nav>

      <header class="upgrade-header">
        <div class="section-eyebrow">⚡ {gpuTr.title}</div>
        <h1 id="upgrade-heading">
          {gpuTr.title}
        </h1>
        <p class="upgrade-intro">
          {gpuTr.desc}
        </p>
      </header>

      {/* === PREACT GPU UPGRADE CHECKER ISLAND === */}
      <div style="margin-bottom: 3rem;">
        <GpuUpgradeChecker
          client:load
          cpus={cpus}
          gpus={gpus}
          psus={psus}
          lang={lang}
        />
      </div>

      {/* === RELATED LINKS === */}
      <section class="links-section" aria-labelledby="links-heading" style="margin-top: 3rem; padding-top: 2rem; border-top:1px solid var(--color-border-subtle);">
        <h2 id="links-heading" style="font-size: 1.25rem; font-weight: 800; color: var(--text-primary); margin-bottom:1rem;">{t.nav.calculatorsDropdown}</h2>
        <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 0.75rem;">
          <a href={l('/psu-calculator', lang)} class="card" style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem; text-decoration:none; border:1px solid var(--color-border-subtle); border-radius:var(--radius-lg); transition:border-color 0.15s;">
            <div>
              <span style="font-size:0.875rem; font-weight:700; color:var(--text-primary); display:block;">{t.nav.psuCalculator}</span>
              <span style="font-size:0.75rem; color:var(--text-secondary);">{t.hero.subtitle}</span>
            </div>
            <span style="color:var(--color-accent-cyan); font-weight:700;">→</span>
          </a>
          <a href={l('/psu-checker', lang)} class="card" style="display:flex; justify-content:space-between; align-items:center; padding:1.25rem; text-decoration:none; border:1px solid var(--color-border-subtle); border-radius:var(--radius-lg); transition:border-color 0.15s;">
            <div>
              <span style="font-size:0.875rem; font-weight:700; color:var(--text-primary); display:block;">{t.nav.psuChecker}</span>
              <span style="font-size:0.75rem; color:var(--text-secondary);">{t.seo.psuCheckerDescription}</span>
            </div>
            <span style="color:var(--color-accent-cyan); font-weight:700;">→</span>
          </a>
        </div>
      </section>
    </div>
  </section>
</Layout>

<style>
.upgrade-checker-page {
  padding: 3rem 0 6rem;
}
.upgrade-header {
  margin-top: 1.5rem;
  margin-bottom: 2.5rem;
}
.upgrade-header h1 {
  font-size: clamp(1.75rem, 4.5vw, 2.75rem);
  font-weight: 850;
  line-height: 1.15;
  letter-spacing: -0.03em;
}
.upgrade-intro {
  font-size: 1rem;
  color: var(--text-secondary);
  margin-top: 0.75rem;
}
.card:hover {
  border-color: var(--color-accent-cyan);
}
</style>
