---
import Layout from '../../layouts/Layout.astro';
import { TARGET_LOCALES, useTranslations, l, type Locale } from '../../i18n';
import { EDITORIAL_POLICY_TRANSLATIONS } from '../../i18n/editorialPolicy';

export async function getStaticPaths() {
  return TARGET_LOCALES.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);
const ep = EDITORIAL_POLICY_TRANSLATIONS[lang] || EDITORIAL_POLICY_TRANSLATIONS.en;

const lastUpdated = "July 14, 2026";
---

<Layout
  title={`${t.footer.editorialPolicy} — PSUCheck`}
  description={ep.metaDesc}
  noIndex={false}
  lang={lang}
>
  <div class="legal-page">
    <div class="legal-hero">
      <div class="container">
        <div class="badge badge-safe" style="margin-bottom:1rem;">{ep.badge}</div>
        <h1>{t.footer.editorialPolicy}</h1>
        <p class="legal-meta">Last updated: {lastUpdated}</p>
      </div>
    </div>

    <div class="legal-body">
      <div class="container">
        <div class="legal-content">

          <p class="about-lead" style="font-size:1.1rem;color:var(--text-secondary);line-height:1.7;">
            {ep.lead}
          </p>

          <h2>{ep.s1Title}</h2>
          <p>{ep.s1P1}</p>
          <p>{ep.s1P2}</p>

          <h2>{ep.s2Title}</h2>
          <p>{ep.s2Lead}</p>
          <ul>
            <li><strong>CPU:</strong> {ep.s2Items.cpu}</li>
            <li><strong>GPU:</strong> {ep.s2Items.gpu}</li>
            <li><strong>Transient Multipliers:</strong> {ep.s2Items.transient}</li>
            <li><strong>ATX 3.1:</strong> {ep.s2Items.atx}</li>
            <li><strong>Efficiency:</strong> {ep.s2Items.efficiency}</li>
            <li><strong>Quality Tiers:</strong> {ep.s2Items.tiers}</li>
          </ul>

          <h2>{ep.s3Title}</h2>
          <p>{ep.s3P1}</p>
          <p>{ep.s3P2}</p>

          <h2>{ep.s4Title}</h2>
          <p>{ep.s4P1}</p>
          <p>{ep.s4P2}</p>

        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
.legal-hero {
  padding: 4rem 0 2rem;
  background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-primary) 100%);
  border-bottom: 1px solid var(--border-subtle);
}
.legal-meta {
  color: var(--text-tertiary);
  font-size: 0.875rem;
  margin-top: 0.5rem;
}
.legal-body {
  padding: 3rem 0 5rem;
}
.legal-content {
  max-width: 760px;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.legal-content h2 {
  font-size: 1.375rem;
  margin-top: 0.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border-subtle);
}
.legal-content p {
  color: var(--text-secondary);
  line-height: 1.75;
  max-width: 70ch;
}
.legal-content ul {
  padding-left: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  color: var(--text-secondary);
  line-height: 1.6;
}
.about-lead {
  max-width: 70ch;
}
</style>
