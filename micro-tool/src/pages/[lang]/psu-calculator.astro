---
import Layout from '../../layouts/Layout.astro';
import { VirtualAssemblyDesk } from '../../components/calculators/VirtualAssemblyDesk';
import { InteractiveTco } from '../../components/calculators/InteractiveTco';
import { TARGET_LOCALES, useTranslations, l, type Locale } from '../../i18n';

export async function getStaticPaths() {
  return TARGET_LOCALES.map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": `${t.nav.psuCalculator} — PSUCheck`,
  "url": `https://psucheck.com/${lang}/psu-calculator`,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "description": t.seo.psuCalcDescription,
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
  "featureList": [
    "Transient power spike analysis",
    "ATX 3.1 compliance checking",
    "Per-rail load analysis",
    "Cable safety and melt prevention audit",
    "5-year TCO electric bill comparison"
  ]
};
---

<Layout
  title={t.seo.psuCalcTitle}
  description={t.seo.psuCalcDescription}
  schema={[schema]}
>
  <!-- Calculator Hero -->
  <section class="calc-hero" aria-labelledby="calc-hero-heading">
    <div class="container">
      <div class="calc-hero-inner">
        <div>
          <div class="calc-breadcrumb" aria-label="Breadcrumb">
            <a href={l('/', lang)}>{t.nav.home}</a>
            <span aria-hidden="true">›</span>
            <span aria-current="page">{t.nav.psuCalculator}</span>
          </div>
          <h1 id="calc-hero-heading" class="calc-h1">
            {t.nav.psuCalculator}
          </h1>
          <p class="calc-subtitle">
            {t.hero.subtitle}
          </p>
        </div>
        <div class="calc-hero-badges" aria-label="Calculator features">
          <span class="badge badge-safe">⚡ Transient Modeling</span>
          <span class="badge badge-safe">✓ ATX 3.1 Aware</span>
          <span class="badge badge-safe">🔌 Cable Audit</span>
          <span class="badge badge-safe">📊 5-Year TCO</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Methodology trust strip -->
  <div class="methodology-strip" role="complementary" aria-label="Data sources">
    <div class="container">
      <div class="methodology-strip-inner">
        <span class="method-label">Data sources:</span>
        <span class="method-item">Cybenetics PSU Lab</span>
        <span class="method-sep" aria-hidden="true">·</span>
        <span class="method-item">NVIDIA / AMD Official TBP</span>
        <span class="method-sep" aria-hidden="true">·</span>
        <span class="method-item">Intel ATX 3.1 Design Guide</span>
        <span class="method-sep" aria-hidden="true">·</span>
        <span class="method-item">80 PLUS Certification Database</span>
        <a href={l('/about#methodology', lang)} class="method-link">{t.footer.methodology} →</a>
      </div>
    </div>
  </div>

  <!-- ===== VIRTUAL ASSEMBLY DESK (Preact Island) ===== -->
  <VirtualAssemblyDesk client:load lang={lang} />

  <!-- ===== TCO SECTION ===== -->
  <section class="tco-section" id="tco" aria-labelledby="tco-heading">
    <div class="container">
      <div class="section-eyebrow">{t.tco.title}</div>
      <h2 id="tco-heading" class="section-heading">
        {t.tco.subtitle}
      </h2>
      <p class="section-lead" style="max-width:56ch;margin-top:0.75rem;margin-bottom:2rem;color:var(--text-secondary);">
        {t.tco.efficiencySavings}
      </p>
      <InteractiveTco client:visible lang={lang} />
    </div>
  </section>
</Layout>

<style>
.calc-hero {
  padding: 4rem 0 2.5rem;
  background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-primary) 100%);
  border-bottom: 1px solid var(--border-subtle);
}
.calc-hero-inner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 2rem;
  flex-wrap: wrap;
}
.calc-breadcrumb {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8125rem;
  color: var(--text-tertiary);
  margin-bottom: 0.75rem;
}
.calc-breadcrumb a { color: var(--text-secondary); }
.calc-breadcrumb a:hover { color: var(--accent-primary); }
.calc-h1 {
  font-size: clamp(2rem, 4.5vw, 3rem);
  line-height: 1.15;
  margin-bottom: 0.75rem;
}
.calc-subtitle {
  font-size: 1.0625rem;
  color: var(--text-secondary);
  max-width: 60ch;
  line-height: 1.6;
}
.calc-hero-badges {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  align-items: flex-end;
  flex-shrink: 0;
}
@media (max-width: 640px) {
  .calc-hero-badges { align-items: flex-start; flex-direction: row; flex-wrap: wrap; }
}
.methodology-strip {
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-subtle);
  padding: 0.75rem 0;
}
.methodology-strip-inner {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  flex-wrap: wrap;
  font-size: 0.75rem;
}
.method-label { font-weight: 700; color: var(--text-tertiary); text-transform: uppercase; letter-spacing: 0.06em; }
.method-item { color: var(--text-secondary); }
.method-sep { color: var(--border-default); }
.method-link { color: var(--accent-primary); margin-left: auto; font-weight: 600; white-space: nowrap; }
.method-link:hover { text-decoration: underline; }

.tco-section { padding: 4rem 0; background: var(--bg-secondary); }
</style>
