---
// PSUCheck / VoltForge — Base Layout with Full i18n & Zero-Bug Localization
// Shared across all MPA routes.
// Dark/light theme via data-theme on <html>.
// Full parity hreflang, OpenGraph, dynamic schemas, accessible language switcher.

import '../styles/tailwind.css';
import '../styles/global.css';
import '../styles/assembly-desk.css';
import '../styles/blueprint.css';
import SearchPalette from '../components/ui/SearchPalette';
import VoltBotAssistant from '../components/chat/VoltBotAssistant';
import LanguageSwitcher from '../components/ui/LanguageSwitcher';
import { getLangFromUrl, l, getAlternateHreflangLinks, getDir, useTranslations, getCleanPath, type Locale } from '../i18n';

export interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  schema?: object | object[];
  noIndex?: boolean;
  lang?: Locale;
}

const {
  title,
  description,
  canonicalUrl: propCanonicalUrl,
  ogImage = '/pc-hero.png',
  schema,
  noIndex = false,
  lang: propLang,
} = Astro.props;

const currentLang: Locale = propLang || getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);
const hreflangLinks = getAlternateHreflangLinks(Astro.url.pathname);

const pathname = Astro.url.pathname;
const normalizedPathname = pathname.endsWith('/') ? pathname : pathname + '/';
const canonicalUrl = propCanonicalUrl || (Astro.url.origin + normalizedPathname);

const siteTitle = title.includes('PSUCheck') || title.includes('VoltForge') ? title : `${title} | PSUCheck`;

const breadcrumbNames: Record<string, string> = {
  '/': t.nav.brand,
  '/build-plan': t.nav.buildBlueprint,
  '/psu-calculator': t.nav.psuCalculator,
  '/pc-builder': t.nav.pcBuilder,
  '/psu-checker': t.nav.psuChecker,
  '/psu-replacement-calculator': t.nav.psuReplacement,
  '/psu-for': t.nav.psuFinder,
  '/compare/ups-calculator': t.nav.upsCalculator,
  '/compare/breaker-calculator': t.nav.breakerCalculator,
  '/charger-for': t.nav.usbCharger,
  '/compare/desktop-vs-laptop': t.nav.desktopVsLaptop,
  '/diagnose': t.nav.diagnosticWizard,
  '/builds': t.nav.completedBuilds,
  '/guides': t.nav.guides,
  '/about': t.nav.aboutUs,
  '/methodology': t.footer.methodology,
  '/privacy-policy': t.footer.privacy,
  '/terms': t.footer.terms,
  '/disclaimer': t.footer.disclaimer,
  '/editorial-policy': t.footer.editorialPolicy,
  '/contact': t.footer.contact,
};

function formatSlug(seg: string): string {
  return seg.replace(/-/g, ' ')
    .replace(/\b\w/g, c => c.toUpperCase())
    .replace(/\bPsu\b/g, 'PSU')
    .replace(/\bAtx\b/g, 'ATX')
    .replace(/\bRtx\b/g, 'RTX')
    .replace(/\bGpu\b/g, 'GPU')
    .replace(/\bCpu\b/g, 'CPU')
    .replace(/\bTco\b/g, 'TCO')
    .replace(/\bSfx\b/g, 'SFX');
}

function buildBreadcrumbSchema(pathname: string, lang: Locale) {
  const cleanPath = getCleanPath(pathname);
  const segments = cleanPath.split('/').filter(Boolean);
  const items = [{ '@type': 'ListItem', position: 1, name: 'Home', item: Astro.url.origin + l('/', lang) }];
  let accumulated = '';
  for (const seg of segments) {
    accumulated += '/' + seg;
    const known = breadcrumbNames[accumulated];
    const name = known || formatSlug(seg);
    const itemUrl = Astro.url.origin + l(accumulated, lang);
    if (accumulated !== cleanPath) {
      items.push({ '@type': 'ListItem', position: items.length + 1, name, item: itemUrl.endsWith('/') ? itemUrl : itemUrl + '/' });
    } else {
      items.push({ '@type': 'ListItem', position: items.length + 1, name });
    }
  }
  if (items.length === 1) return null;
  return { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items };
}

// Dynamic TechArticle injection for guide subpages
const isGuidePage = Astro.url.pathname.includes('/guides/') && !Astro.url.pathname.endsWith('/guides') && !Astro.url.pathname.endsWith('/guides/');
const techArticleSchema = isGuidePage ? {
  "@type": "TechArticle",
  "headline": title,
  "description": description,
  "image": [Astro.url.origin + ogImage],
  "datePublished": "2026-01-15T08:00:00Z",
  "dateModified": "2026-07-13T08:00:00Z",
  "inLanguage": currentLang,
  "author": {
    "@type": "Organization",
    "name": "PSUCheck Engineering Team",
    "url": "https://psucheck.com/about"
  },
  "publisher": {
    "@type": "Organization",
    "name": "PSUCheck",
    "logo": {
      "@type": "ImageObject",
      "url": "https://psucheck.com/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
} : null;

// Combine schemas under @graph
let finalSchemas = [];
if (schema) {
  if (Array.isArray(schema)) {
    finalSchemas.push(...schema);
  } else {
    finalSchemas.push(schema);
  }
}
if (techArticleSchema) {
  finalSchemas.push(techArticleSchema);
}

const schemaStr = finalSchemas.length > 0
  ? JSON.stringify(finalSchemas.length === 1 ? finalSchemas[0] : { '@context': 'https://schema.org', '@graph': finalSchemas }, null, 0)
  : null;
---

<!DOCTYPE html>
<html lang={currentLang} dir={getDir(currentLang)} data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-WF0HWETT8P" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-WF0HWETT8P');
  </script>
  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5910777021067126" crossorigin="anonymous" is:inline></script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="yandex-verification" content="6b305a222b45edbc" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta http-equiv="content-language" content={currentLang} />
  <title>{siteTitle}</title>
  <meta name="description" content={description} />
  {!noIndex && <link rel="canonical" href={canonicalUrl} />}
  {noIndex && <meta name="robots" content="noindex, nofollow" />}
  
  <!-- Bidirectional Alternate Hreflang Links -->
  {hreflangLinks.map(link => (
    <link rel="alternate" hreflang={link.lang} href={link.href} />
  ))}

  <meta property="og:type" content="website" />
  <meta property="og:title" content={siteTitle} />
  <meta property="og:description" content={description} />
  {!noIndex && <meta property="og:url" content={canonicalUrl} />}
  <meta property="og:image" content={new URL(ogImage, Astro.site).href} />
  <meta property="og:site_name" content="PSUCheck" />
  <meta property="og:locale" content={currentLang} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={siteTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Design system fonts: Fira Code + Fira Sans -->
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Fira+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="PSUCheck" />
  <link rel="manifest" href="/site.webmanifest" />
  <script is:inline>
    (function() {
      const stored = localStorage.getItem('vf-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = stored || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  {schemaStr && <script type="application/ld+json" set:html={schemaStr} />}
  {buildBreadcrumbSchema(Astro.url.pathname, currentLang) && <script type="application/ld+json" set:html={JSON.stringify(buildBreadcrumbSchema(Astro.url.pathname, currentLang))} />}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context":"https://schema.org","@type":"Organization",
    "name":"PSUCheck","url":"https://psucheck.com",
    "description":"Independent PC power supply calculator and build cost estimator.",
    "logo":{"@type":"ImageObject","url":"https://psucheck.com/favicon.svg"},
    "contactPoint":{"@type":"ContactPoint","contactType":"customer support","url":"https://psucheck.com/contact"}
  })} />
</head>
<body>
  <a href="#main-content" class="skip-link">{t.nav.skipToContent}</a>

  <header class="site-header" role="banner">
    <div class="container">
      <nav class="nav-inner" role="navigation" aria-label="Main navigation">
        <a href={l('/', currentLang)} class="nav-logo" aria-label="PSUCheck home">{t.nav.brand}</a>
        <ul class="nav-links" id="nav-links">
          <li class="nav-dropdown-wrapper">
            <button class="nav-dropdown-trigger" id="nav-dropdown-trigger" aria-haspopup="true" aria-expanded="false" type="button">
              {t.nav.calculatorsDropdown} <span class="chevron" aria-hidden="true">▼</span>
            </button>
            <ul class="nav-dropdown-menu" id="nav-dropdown-menu">
              <li><a href={l('/build-plan', currentLang)}>{t.nav.buildBlueprint}</a></li>
              <li><a href={l('/psu-calculator', currentLang)}>{t.nav.psuCalculator}</a></li>
              <li><a href={l('/psu-checker', currentLang)}>{t.nav.psuChecker}</a></li>
              <li><a href={l('/psu-replacement-calculator', currentLang)}>{t.nav.psuReplacement}</a></li>
              <li><a href={l('/pc-builder', currentLang)}>{t.nav.pcBuilder}</a></li>
              <li><a href={l('/psu-for/rtx-5080', currentLang)}>{t.nav.psuFinder}</a></li>
              <li><a href={l('/compare/ups-calculator', currentLang)}>{t.nav.upsCalculator}</a></li>
              <li><a href={l('/compare/breaker-calculator', currentLang)}>{t.nav.breakerCalculator}</a></li>
              <li><a href={l('/charger-for', currentLang)}>{t.nav.usbCharger}</a></li>
              <li><a href={l('/compare/desktop-vs-laptop', currentLang)}>{t.nav.desktopVsLaptop}</a></li>
              <li><a href={l('/diagnose', currentLang)}>{t.nav.diagnosticWizard}</a></li>
            </ul>
          </li>
          <li><a href={l('/builds', currentLang)}>{t.nav.completedBuilds}</a></li>
          <li><a href={l('/guides', currentLang)}>{t.nav.guides}</a></li>
          <li><a href={l('/about', currentLang)}>{t.nav.aboutUs}</a></li>
        </ul>
        <div class="nav-right" style="display:flex; align-items:center; gap:8px;">
          <LanguageSwitcher currentLang={currentLang} client:idle />
          <button class="search-trigger-btn" id="search-trigger-btn" aria-label={t.nav.searchAria} type="button">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8" />
              <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <span class="search-trigger-text">{t.nav.search}</span>
            <kbd class="search-trigger-kbd">⌘K</kbd>
          </button>
          <button class="theme-toggle" id="theme-toggle" aria-label={t.nav.themeToggleAria} type="button">
            <span class="theme-slider-thumb">
              <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
              <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            </span>
          </button>
          <button class="nav-mobile-toggle" id="nav-mobile-toggle" aria-label={t.nav.menuOpenAria} aria-expanded="false" aria-controls="nav-links" type="button">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
        </div>
      </nav>
    </div>
  </header>

  <script is:inline>
    document.getElementById('search-trigger-btn')?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-global-search'));
    });
  </script>

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <!-- Feedback and Share Bar -->
  <section class="feedback-share-bar" aria-label="Page feedback and sharing">
    <div class="container" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:1.5rem; padding:1.5rem 1rem; border-top:1px solid var(--color-border-subtle); border-bottom:1px solid var(--color-border-subtle); margin-top:3rem; margin-bottom:1rem;">
      <!-- Feedback Widget -->
      <div id="feedback-widget" style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
        <span style="font-weight:700; font-size:0.875rem; color:var(--color-text-secondary);">{t.feedback.helpfulQuestion}</span>
        <button id="feedback-btn-yes" class="btn btn-secondary btn-sm" style="min-height:32px; padding:4px 12px; font-size:0.8rem; display:inline-flex; align-items:center; gap:4px;" type="button">{t.feedback.yesBtn}</button>
        <button id="feedback-btn-no" class="btn btn-secondary btn-sm" style="min-height:32px; padding:4px 12px; font-size:0.8rem; display:inline-flex; align-items:center; gap:4px;" type="button">{t.feedback.noBtn}</button>
        <span id="feedback-thanks" style="display:none; font-size:0.875rem; font-weight:700; color:var(--color-accent-cyan);">{t.feedback.thanks}</span>
      </div>

      <!-- Social Share Links -->
      <div style="display:flex; align-items:center; gap:0.75rem; flex-wrap:wrap;">
        <span style="font-weight:700; font-size:0.875rem; color:var(--color-text-secondary);">{t.feedback.shareLabel}</span>
        <a href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="min-height:32px; padding:4px 12px; font-size:0.8rem; text-decoration:none;" aria-label="Share on X (Twitter)">X / Twitter</a>
        <a href={`https://www.reddit.com/submit?title=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="min-height:32px; padding:4px 12px; font-size:0.8rem; text-decoration:none;" aria-label="Share on Reddit">Reddit</a>
        <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm" style="min-height:32px; padding:4px 12px; font-size:0.8rem; text-decoration:none;" aria-label="Share on Facebook">Facebook</a>
      </div>
    </div>
  </section>

  <!-- Client-side script to handle localStorage feedback storing -->
  <script is:inline>
    (function() {
      const pathname = window.location.pathname;
      const yesBtn = document.getElementById('feedback-btn-yes');
      const noBtn = document.getElementById('feedback-btn-no');
      const thanksText = document.getElementById('feedback-thanks');
      
      const stored = localStorage.getItem('helpful_' + pathname);
      if (stored) {
        if (yesBtn && noBtn) {
          yesBtn.style.display = 'none';
          noBtn.style.display = 'none';
        }
        if (thanksText) thanksText.style.display = 'inline';
      }

      function handleFeedback(status) {
        localStorage.setItem('helpful_' + pathname, status);
        if (yesBtn && noBtn) {
          yesBtn.style.display = 'none';
          noBtn.style.display = 'none';
        }
        if (thanksText) {
          thanksText.style.display = 'inline';
        }
      }

      if (yesBtn) yesBtn.addEventListener('click', () => handleFeedback('yes'));
      if (noBtn) noBtn.addEventListener('click', () => handleFeedback('no'));
    })();
  </script>

  <footer class="site-footer" role="contentinfo">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-section">
          <a href={l('/', currentLang)} class="nav-logo" style="display:inline-block;margin-bottom:0.75rem;">{t.footer.aboutTitle}</a>
          <p style="font-size:0.875rem;max-width:32ch;">{t.footer.aboutDesc}</p>
          <p style="font-size:0.75rem;margin-top:0.75rem;color:var(--text-tertiary);">{t.footer.methodologyNote}</p>
          <div style="margin-top:1.25rem;">
            <LanguageSwitcher currentLang={currentLang} variant="footer" client:idle />
          </div>
        </div>
        <div class="footer-section">
          <h4>{t.footer.calculatorsCol}</h4>
          <ul>
            <li><a href={l('/psu-calculator', currentLang)}>{t.nav.psuCalculator}</a></li>
            <li><a href={l('/psu-for/', currentLang)}>{t.nav.psuFinder}</a></li>
            <li><a href={l('/best-psu', currentLang)}>{t.bestPsu.title.split('—')[0]}</a></li>
            <li><a href={l('/pc-builder', currentLang)}>{t.nav.pcBuilder}</a></li>
            <li><a href={l('/build-plan', currentLang)}>{t.nav.buildBlueprint}</a></li>
            <li><a href={l('/psu-checker', currentLang)}>{t.nav.psuChecker}</a></li>
            <li><a href={l('/psu-replacement-calculator', currentLang)}>{t.nav.psuReplacement}</a></li>
            <li><a href={l('/compare/ups-calculator', currentLang)}>{t.nav.upsCalculator}</a></li>
            <li><a href={l('/compare/breaker-calculator', currentLang)}>{t.nav.breakerCalculator}</a></li>
            <li><a href={l('/charger-for/', currentLang)}>{t.nav.usbCharger}</a></li>
            <li><a href={l('/compare/desktop-vs-laptop', currentLang)}>{t.nav.desktopVsLaptop}</a></li>
            <li><a href={l('/methodology', currentLang)}>{t.footer.methodology}</a></li>
            <li><a href={l('/diagnose', currentLang)}>{t.nav.diagnosticWizard}</a></li>
          </ul>
        </div>
        <div class="footer-section">
          <h4><a href={l('/guides', currentLang)} style="color:inherit;text-decoration:none;">{t.footer.guidesCol}</a></h4>
          <ul>
            <li><a href={l('/guides/how-to-build-a-pc', currentLang)}>How to Build a PC</a></li>
            <li><a href={l('/guides/atx-3-1-guide', currentLang)}>ATX 3.1 Guide</a></li>
            <li><a href={l('/guides/psu-sizing-guide', currentLang)}>PSU Sizing Guide</a></li>
            <li><a href={l('/guides/psu-efficiency-guide', currentLang)}>80+ Efficiency Guide</a></li>
            <li><a href={l('/guides/budget-guide', currentLang)}>PC Budget Guide</a></li>
            <li><a href={l('/guides/building-tips', currentLang)}>Building Tips</a></li>
          </ul>
        </div>
        <div class="footer-section">
          <h4>{t.footer.companyCol}</h4>
          <ul>
            <li><a href={l('/about', currentLang)}>{t.footer.contact ? t.nav.aboutUs : 'About Us'}</a></li>
            <li><a href={l('/contact', currentLang)}>{t.footer.contact}</a></li>
            <li><a href={l('/privacy-policy', currentLang)}>{t.footer.privacy}</a></li>
            <li><a href={l('/terms', currentLang)}>{t.footer.terms}</a></li>
            <li><a href={l('/disclaimer', currentLang)}>{t.footer.disclaimer}</a></li>
            <li><a href={l('/editorial-policy', currentLang)}>{t.footer.editorialPolicy}</a></li>
            <li><a href={l('/methodology', currentLang)}>{t.footer.methodology}</a></li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <div>
          <p>&copy; {new Date().getFullYear()} {t.footer.aboutTitle}. {t.footer.copyright}</p>
          <p style="margin-top:0.25rem;">{t.footer.affiliateDisclosure}</p>
        </div>
        <div style="display:flex;gap:1rem;align-items:center;flex-wrap:wrap;">
          <a href={l('/privacy-policy', currentLang)} style="color:var(--text-tertiary);font-size:0.75rem;">{t.footer.privacy}</a>
          <a href={l('/terms', currentLang)} style="color:var(--text-tertiary);font-size:0.75rem;">{t.footer.terms}</a>
          <a href={l('/disclaimer', currentLang)} style="color:var(--text-tertiary);font-size:0.75rem;">{t.footer.disclaimer}</a>
          <a href={l('/contact', currentLang)} style="color:var(--text-tertiary);font-size:0.75rem;">{t.footer.contact}</a>
        </div>
      </div>
    </div>
  </footer>

  <script is:inline>
    const toggle = document.getElementById('theme-toggle');
    const html = document.documentElement;
    function applyTheme(theme) {
      html.setAttribute('data-theme', theme);
      localStorage.setItem('vf-theme', theme);
      if (theme === 'dark') {
        toggle.setAttribute('aria-label', 'Switch to light mode');
      } else {
        toggle.setAttribute('aria-label', 'Switch to dark mode');
      }
    }
    applyTheme(html.getAttribute('data-theme') || 'dark');
    toggle?.addEventListener('click', () => {
      applyTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });

    const mobileToggle = document.getElementById('nav-mobile-toggle');
    const navLinks = document.getElementById('nav-links');
    mobileToggle?.addEventListener('click', () => {
      const isOpen = navLinks.classList.toggle('open');
      mobileToggle.setAttribute('aria-expanded', String(isOpen));
    });

    const dropdownTrigger = document.getElementById('nav-dropdown-trigger');
    const dropdownMenu = document.getElementById('nav-dropdown-menu');
    dropdownTrigger?.addEventListener('click', (e) => {
      const isExpanded = dropdownTrigger.getAttribute('aria-expanded') === 'true';
      dropdownTrigger.setAttribute('aria-expanded', String(!isExpanded));
      dropdownMenu.classList.toggle('show');
      e.stopPropagation();
    });

    document.addEventListener('click', (e) => {
      if (mobileToggle && navLinks && !mobileToggle.contains(e.target) && !navLinks.contains(e.target)) {
        navLinks.classList.remove('open');
        mobileToggle.setAttribute('aria-expanded', 'false');
      }
      if (dropdownTrigger && dropdownMenu && !dropdownTrigger.contains(e.target)) {
        dropdownTrigger.setAttribute('aria-expanded', 'false');
        dropdownMenu.classList.remove('show');
      }
    });

    // Active navigation link detection
    try {
      const currentPath = window.location.pathname;
      const links = document.querySelectorAll('.nav-links a');
      links.forEach(link => {
        const linkPath = new URL(link.href).pathname;
        if (currentPath === linkPath || (linkPath !== '/' && linkPath !== '/de' && linkPath !== '/es' && linkPath !== '/fr' && linkPath !== '/ja' && linkPath !== '/zh' && currentPath.startsWith(linkPath))) {
          link.classList.add('active');
          link.setAttribute('aria-current', 'page');
        }
      });

      if (dropdownMenu && dropdownMenu.querySelector('a.active')) {
        dropdownTrigger?.classList.add('active');
      }
    } catch (err) {
      console.warn('Active nav state calculation failed', err);
    }
  </script>
  <SearchPalette currentLang={currentLang} client:idle />
  <VoltBotAssistant currentLang={currentLang} client:idle />
</body>
</html>
